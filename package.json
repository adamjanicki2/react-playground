{
  "name": "react-playground",
  "homepage": "https://adamjanicki.xyz/react-playground",
  "private": true,
  "type": "module",
  "dependencies": {
    "@adamjanicki/ui": "^1.9.3",
    "@babel/standalone": "^7.28.4",
    "@uiw/codemirror-extensions-langs": "^4.25.1",
    "@uiw/codemirror-theme-eclipse": "^4.25.1",
    "@uiw/codemirror-theme-github": "^4.25.1",
    "@uiw/codemirror-theme-vscode": "^4.25.1",
    "@uiw/codemirror-theme-xcode": "^4.25.1",
    "@uiw/react-codemirror": "^4.25.1",
    "lz-string": "^1.5.0",
    "re-resizable": "^6.11.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-syntax-highlighter": "^16.1.0",
    "zustand": "^5.0.8"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && eslint src --max-warnings=0 && vite build && cp build/index.html build/404.html",
    "lint": "eslint src --fix && prettier --write \"src/**/*.{ts,tsx,json,css,scss,md}\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "devDependencies": {
    "@types/babel__standalone": "^7.1.9",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "gh-pages": "^6.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-svgr": "^4.3.0"
  }
}
